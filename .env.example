# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Super Admin
SUPER_ADMIN_ID=123456789

# Database Configuration
# DB_TYPE: postgresql, sqlite, or memory (in-memory SQLite for development/testing)
DB_TYPE=postgresql

# PostgreSQL Configuration (used when DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swiftdevbot
DB_USER=postgres
DB_PASSWORD=your_password_here

# SQLite Configuration (used when DB_TYPE=sqlite)
# DB_PATH=Data/database/swiftdevbot.db

# For development/testing with in-memory SQLite:
# DB_TYPE=memory
# DB_PASSWORD=  # Optional for SQLite

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Web Panel Configuration
WEB_PANEL_URL=http://localhost:8000

# JWT Secret (minimum 32 characters)
JWT_SECRET=your_secret_key_minimum_32_characters_long_please_change_this

# Logging
LOG_LEVEL=INFO
